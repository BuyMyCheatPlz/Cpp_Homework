{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Eigen_Project (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/Eigen_Project/matrix.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/Eigen_Project",
      "environment": [
        {
          "name": "PATH",
          "value": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
        }
      ],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "为 gdb 启用整齐打印",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build"
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": true,
      "cwd": "c:/Users/wangy/Cpp_Homework/Eigen_Project",
      "program": "c:/Users/wangy/Cpp_Homework/Eigen_Project/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}