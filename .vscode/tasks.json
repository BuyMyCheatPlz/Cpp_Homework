{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-g",
                "-std=c++11",
                "-static",
                "-I",
                "C:/Eigen",
                "${workspaceFolder}/Eigen_Project/main.cpp",
                "${workspaceFolder}/Eigen_Project/matrix_ops.cpp",
                "${workspaceFolder}/Eigen_Project/eigen_verify.cpp",
                "-o",
                "${workspaceFolder}/Eigen_Project/matrix.exe"
            ],
            "options": {
                "env": {
                    "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent",
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build-check-student",
            "type": "shell",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-g",
                "-std=c++11",
                "-static",
                "${workspaceFolder}/Check_Student/chkstd.cpp",
                "-o",
                "${workspaceFolder}/Check_Student/chkstd.exe"
            ],
            "options": {
                "env": {
                    "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
                }
            },
            "group": "build",
            "presentation": {
                "reveal": "silent",
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
